# results.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-tls12-handshake
# Cu phap: ten_the = container:tep : KIEU_TRUONG : gia_tri

#DOC: Da mo Wireshark de bat goi tin
capture = client:.bash_history : CONTAINS : wireshark

#DOC: Da ep ket noi HTTPS dung TLS 1.2 bang tuy chon --tlsv1.2 cua curl
tls12_request = client:.bash_history : CONTAINS : --tlsv1.2

#DOC: Da xac dinh dung phien ban giao thuc trong phien bat tay
answer_version = client:answer.txt : CONTAINS : version=TLSv1.2

#DOC: Da xac dinh dung bo ma hoa (cipher suite) ma may chu chon
answer_cipher = client:answer.txt : CONTAINS : cipher=ECDHE-RSA-AES256-GCM-SHA384

#DOC: Da xac dinh dung ma loai ban tin Server Key Exchange (handshake type = 12)
answer_ske = client:answer.txt : CONTAINS : server_key_exchange=12

#DOC: Da xac dinh dung ma loai ban tin Client Key Exchange (handshake type = 16)
answer_cke = client:answer.txt : CONTAINS : client_key_exchange=16
