# Bai thuc hanh: net-tls12-handshake

#DOC: Da bat goi tin bang Wireshark
capture_done = boolean : (capture)

#DOC: Da tao phien TLS 1.2 den may chu
traffic_done = boolean : (tls12_request)

#DOC: Da phan tich dung phien bat tay TLS 1.2
analysis_done = boolean : (answer_version and answer_cipher and answer_ske and answer_cke)

#DOC: Hoan thanh toan bo bai thuc hanh
lab_done = boolean : (capture and tls12_request and answer_version and answer_cipher and answer_ske and answer_cke)
