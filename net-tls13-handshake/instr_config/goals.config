# Bai thuc hanh: net-tls13-handshake

#DOC: Da bat goi tin bang Wireshark
capture_done = boolean : (capture)

#DOC: Da tao phien TLS 1.3 den may chu
traffic_done = boolean : (tls13_request)

#DOC: Da phan tich dung phien bat tay TLS 1.3
analysis_done = boolean : (answer_version and answer_sv and answer_cert and answer_rtt)

#DOC: Hoan thanh toan bo bai thuc hanh
lab_done = boolean : (capture and tls13_request and answer_version and answer_sv and answer_cert and answer_rtt)
