# results.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-tls13-handshake
# Cu phap: ten_the = container:tep : KIEU_TRUONG : gia_tri

#DOC: Da mo Wireshark de bat goi tin
capture = client:.bash_history : CONTAINS : wireshark

#DOC: Da ep ket noi HTTPS dung TLS 1.3 bang tuy chon --tlsv1.3 cua curl
tls13_request = client:.bash_history : CONTAINS : --tlsv1.3

#DOC: Da xac dinh dung phien ban giao thuc cua phien
answer_version = client:answer.txt : CONTAINS : version=TLSv1.3

#DOC: Da doc dung gia tri extension supported_versions trong Server Hello
answer_sv = client:answer.txt : CONTAINS : supported_versions=0x0304

#DOC: Da nhan ra chung chi khong con nhin thay duoc (da bi ma hoa) trong TLS 1.3
answer_cert = client:answer.txt : CONTAINS : certificate_visible=no

#DOC: Da xac dinh dung so luot trao doi (round trip) truoc khi gui du lieu
answer_rtt = client:answer.txt : CONTAINS : rtt=1
