# Filename : start.config
# Description:
#     Khai bao cac container cua bai Lab net-tls13-handshake
# Mo hinh: 1 may client + 1 may server trong cung mot mang ao.

GLOBAL_SETTINGS
        # GRADE_CONTAINER - container noi giang vien thuc hien cham diem
	GRADE_CONTAINER client

        # HOST_HOME_XFER - thu muc trao doi du lieu voi container, tinh tu HOME
	HOST_HOME_XFER seed_dir/

	# LAB_MASTER_SEED - chuoi seed rieng cua bai Lab
	LAB_MASTER_SEED net_tls13_handshake_master_seed

NETWORK LAN
        MASK 172.25.0.0/24
        GATEWAY 172.25.0.101

CONTAINER client
	USER ubuntu
        PASSWORD password4ubuntu
        TERMINALS 1
        LAN 172.25.0.2
        ADD-HOST server:172.25.0.3
        SCRIPT NONE
        X11 YES

CONTAINER server
	USER ubuntu
        PASSWORD password4ubuntu
        TERMINALS 1
        LAN 172.25.0.3
        ADD-HOST client:172.25.0.2
        SCRIPT NONE
