# goals.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-tls-hello

#DOC: Da bat goi tin bang Wireshark
capture_done = boolean : (capture)

#DOC: Da tao ket noi HTTPS de sinh ban tin TLS Hello
traffic_done = boolean : (tls_request)

#DOC: Da phan tich dung Client Hello va Server Hello
analysis_done = boolean : (answer_sni and answer_client_hello and answer_server_hello)

#DOC: Hoan thanh toan bo bai thuc hanh
lab_done = boolean : (capture and tls_request and answer_sni and answer_client_hello and answer_server_hello)
