# results.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-tls-hello
# Cu phap: ten_the = container:tep : KIEU_TRUONG : gia_tri

#DOC: Da mo Wireshark de bat goi tin
capture = client:.bash_history : CONTAINS : wireshark

#DOC: Da tao ket noi HTTPS den may chu (sinh ra ban tin Client Hello va Server Hello)
tls_request = client:.bash_history : CONTAINS : https://server

#DOC: Da doc dung ten may chu (SNI) trong ban tin Client Hello
answer_sni = client:answer.txt : CONTAINS : sni=server

#DOC: Da xac dinh dung ma loai ban tin Client Hello (handshake type = 1)
answer_client_hello = client:answer.txt : CONTAINS : client_hello=1

#DOC: Da xac dinh dung ma loai ban tin Server Hello (handshake type = 2)
answer_server_hello = client:answer.txt : CONTAINS : server_hello=2
