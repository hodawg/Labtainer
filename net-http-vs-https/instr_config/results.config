# results.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-http-vs-https
# Cu phap: ten_the = container:tep : KIEU_TRUONG : gia_tri

#DOC: Da mo Wireshark de bat goi tin
capture = client:.bash_history : CONTAINS : wireshark

#DOC: Da gui yeu cau POST dang nhap qua HTTP (cong 80)
http_post = client:.bash_history : CONTAINS : http://server/login

#DOC: Da gui yeu cau POST dang nhap qua HTTPS (cong 443)
https_post = client:.bash_history : CONTAINS : https://server/login

#DOC: Da tim thay mat khau bi lo trong luu luong HTTP va ghi vao answer.txt
answer_leaked = client:answer.txt : CONTAINS : leaked=Secret@123

#DOC: Da xac dinh dung cong cua giao thuc lo noi dung (HTTP, cong 80)
answer_http_port = client:answer.txt : CONTAINS : plaintext_port=80

#DOC: Da xac dinh dung cong cua giao thuc ma hoa noi dung (HTTPS, cong 443)
answer_https_port = client:answer.txt : CONTAINS : encrypted_port=443
