# goals.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-http-vs-https

#DOC: Da bat goi tin bang Wireshark
capture_done = boolean : (capture)

#DOC: Da tao luu luong dang nhap qua HTTP va HTTPS
traffic_done = boolean : (http_post and https_post)

#DOC: Da phan tich dung: tim thay mat khau, xac dinh cong HTTP va HTTPS
analysis_done = boolean : (answer_leaked and answer_http_port and answer_https_port)

#DOC: Hoan thanh toan bo bai thuc hanh
lab_done = boolean : (capture and http_post and https_post and answer_leaked and answer_http_port and answer_https_port)
