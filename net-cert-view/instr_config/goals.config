#DOC: Da bat goi tin bang Wireshark
capture_done = boolean : (capture)

#DOC: Da lay chung chi cua may chu bang openssl
traffic_done = boolean : (cert_view)

#DOC: Da doc dung Subject, Issuer va thoi han chung chi
analysis_done = boolean : (answer_subject and answer_issuer and answer_validity)

#DOC: Hoan thanh toan bo bai thuc hanh
lab_done = boolean : (capture and cert_view and answer_subject and answer_issuer and answer_validity)
