# results.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-cert-view
# Cu phap: ten_the = container:tep : KIEU_TRUONG : gia_tri

#DOC: Da mo Wireshark de bat goi tin
capture = client:.bash_history : CONTAINS : wireshark

#DOC: Da dung openssl s_client de lay chung chi cua may chu
cert_view = client:.bash_history : CONTAINS : s_client

#DOC: Da doc dung truong Subject (CN) cua chung chi
answer_subject = client:answer.txt : CONTAINS : subject_cn=server

#DOC: Da doc dung truong Issuer (CN) cua chung chi (tu ky nen trung Subject)
answer_issuer = client:answer.txt : CONTAINS : issuer_cn=server

#DOC: Da tinh dung thoi han hieu luc cua chung chi (ngay)
answer_validity = client:answer.txt : CONTAINS : validity_days=3650
