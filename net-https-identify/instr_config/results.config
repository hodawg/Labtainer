# results.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-https-identify
# Cu phap: ten_the = container:tep : KIEU_TRUONG : gia_tri

#DOC: Da mo Wireshark de bat goi tin
capture = client:.bash_history : CONTAINS : wireshark

#DOC: Da tao luu luong HTTPS toi may chu
https_request = client:.bash_history : CONTAINS : https://server

#DOC: Da tao luu luong HTTP de doi chieu
http_request = client:.bash_history : CONTAINS : http://server

#DOC: Da ghi dung cong HTTPS (443) vao answer.txt
answer_port = client:answer.txt : CONTAINS : 443

#DOC: Da ghi dung giao thuc hien thi tren Wireshark (TLS) vao answer.txt
answer_protocol = client:answer.txt : CONTAINS : TLS
