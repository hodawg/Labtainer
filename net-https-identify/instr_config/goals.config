# goals.config
#
# Please see the Labtainer Designer Lab Designer User Guide
#
# Bai thuc hanh: net-https-identify

#DOC: Da bat goi tin bang Wireshark
capture_done = boolean : (capture)

#DOC: Da tao luu luong HTTPS va HTTP
traffic_done = boolean : (https_request and http_request)

#DOC: Da nhan dien dung cong 443 va giao thuc TLS
identify_done = boolean : (answer_port and answer_protocol)

#DOC: Hoan thanh toan bo bai thuc hanh
lab_done = boolean : (capture and https_request and http_request and answer_port and answer_protocol)
